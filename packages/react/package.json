{
  "name": "@larawag/react",
  "version": "0.1.0",
  "description": "React 19 component and hook for @larawag/core, the three.js view of a hypothetical planetary system.",
  "keywords": [
    "react",
    "three",
    "threejs",
    "exoplanet",
    "planetary-system",
    "astronomy",
    "visualization",
    "3d"
  ],
  "license": "MIT",
  "author": "rach",
  "homepage": "https://github.com/rachzy/larawag/tree/main/packages/react#readme",
  "bugs": {
    "url": "https://github.com/rachzy/larawag/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rachzy/larawag.git",
    "directory": "packages/react"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
